{
  "buildCommand": "echo 'No build needed'",
  "outputDirectory": ".",
  "framework": null,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.atacamadarksky.cl"
        }
      ],
      "destination": "https://atacamadarksky.cl/:path*",
      "permanent": true
    },
    {
      "source": "/stargazing-guide-2026.html",
      "destination": "/sky-guide",
      "permanent": true
    },
    {
      "source": "/stargazing-guide-2026",
      "destination": "/sky-guide",
      "permanent": true
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/cron-bookings",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/gyg-sync?token=atacama-cron-2024",
      "schedule": "0 11 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/pago",
      "destination": "/pago.html"
    },
    {
      "source": "/api/klook/octo/bookings/:uuid/confirm",
      "destination": "/api/suppliers"
    },
    {
      "source": "/api/klook/octo/bookings/:uuid/cancel",
      "destination": "/api/suppliers"
    },
    {
      "source": "/api/klook/octo/bookings/:uuid",
      "destination": "/api/suppliers"
    },
    {
      "source": "/api/klook/octo/availability/calendar",
      "destination": "/api/suppliers"
    },
    {
      "source": "/api/klook/octo/products/:id",
      "destination": "/api/suppliers"
    },
    {
      "source": "/api/klook/octo/:path*",
      "destination": "/api/suppliers"
    },
    {
      "source": "/api/klook/octo",
      "destination": "/api/suppliers"
    },
    {
      "source": "/api/gyg/:version/suppliers/:supplierId/products/",
      "destination": "/api/suppliers"
    },
    {
      "source": "/api/gyg/:version/suppliers/:supplierId/products",
      "destination": "/api/suppliers"
    },
    {
      "source": "/api/gyg/:version/products/:productId/pricing-categories/",
      "destination": "/api/suppliers"
    },
    {
      "source": "/api/gyg/:version/products/:productId/pricing-categories",
      "destination": "/api/suppliers"
    },
    {
      "source": "/api/gyg/:version/products/:productId/addons/",
      "destination": "/api/suppliers"
    },
    {
      "source": "/api/gyg/:version/products/:productId/addons",
      "destination": "/api/suppliers"
    },
    {
      "source": "/api/gyg/:version/products/:productId",
      "destination": "/api/suppliers"
    },
    {
      "source": "/api/gyg/:version/:action",
      "destination": "/api/suppliers"
    },
    {
      "source": "/api/gyg/:version/:action/",
      "destination": "/api/suppliers"
    },
    {
      "source": "/api/viator/:action",
      "destination": "/api/suppliers"
    },
    {
      "source": "/api/viator/:action/",
      "destination": "/api/suppliers"
    },
    {
      "source": "/api/viator/admin/:endpoint",
      "destination": "/api/suppliers"
    },
    {
      "source": "/gallery/:slug/",
      "destination": "/api/gallery?slug=:slug"
    },
    {
      "source": "/gallery/:slug",
      "destination": "/api/gallery?slug=:slug"
    },
    {
      "source": "/gallery/",
      "destination": "/api/gallery?action=page-index"
    },
    {
      "source": "/gallery",
      "destination": "/api/gallery?action=page-index"
    },
    {
      "source": "/observatory-log",
      "destination": "/api/gallery?action=page-log"
    },
    {
      "source": "/experience",
      "destination": "/experience.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/sky-guide",
      "destination": "/sky-guide.html"
    }
  ]
}