{
  "buildCommand": "echo 'No build needed'",
  "outputDirectory": ".",
  "framework": null,
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    },
    "api/auth/[...nextauth].js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth/[...nextauth].js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}