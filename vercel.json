{
  "buildCommand": "echo 'No build needed'",
  "outputDirectory": ".",
  "framework": null,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.atacamadarksky.cl"
        }
      ],
      "destination": "https://atacamadarksky.cl/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/cron-bookings",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron-sync-cancellations",
      "schedule": "0 */4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/pago",
      "destination": "/pago.html"
    },
    {
      "source": "/api/gyg/:version/suppliers/:supplierId/products/",
      "destination": "/api/gyg"
    },
    {
      "source": "/api/gyg/:version/suppliers/:supplierId/products",
      "destination": "/api/gyg"
    },
    {
      "source": "/api/gyg/:version/products/:productId/pricing-categories/",
      "destination": "/api/gyg"
    },
    {
      "source": "/api/gyg/:version/products/:productId/pricing-categories",
      "destination": "/api/gyg"
    },
    {
      "source": "/api/gyg/:version/products/:productId/addons/",
      "destination": "/api/gyg"
    },
    {
      "source": "/api/gyg/:version/products/:productId/addons",
      "destination": "/api/gyg"
    },
    {
      "source": "/api/gyg/:version/products/:productId",
      "destination": "/api/gyg"
    },
    {
      "source": "/api/gyg/:version/:action",
      "destination": "/api/gyg"
    },
    {
      "source": "/api/gyg/:version/:action/",
      "destination": "/api/gyg"
    },
    {
      "source": "/api/viator/:action",
      "destination": "/api/viator"
    },
    {
      "source": "/api/viator/:action/",
      "destination": "/api/viator"
    },
    {
      "source": "/api/viator/admin/:endpoint",
      "destination": "/api/viator"
    },
    {
      "source": "/api/agencies/:agencyId/:action",
      "destination": "/api/agencies"
    },
    {
      "source": "/api/agencies/:agencyId",
      "destination": "/api/agencies"
    }
  ]
}